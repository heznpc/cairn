{
  "name": "@yakdo/cairn",
  "version": "0.2.0",
  "description": "Type an address, get a pictogram map. Korean-style 약도, auto-generated. MCP server + CLI.",
  "type": "module",
  "bin": {
    "cairn": "dist/cli.js",
    "cairn-mcp": "dist/server.js"
  },
  "main": "./dist/server.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "start": "node dist/server.js",
    "dev:server": "tsx watch src/server.ts",
    "dev:cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "visual:audit": "npm run build && node scripts/yakdo-visual-audit.mjs",
    "pack:dry": "npm pack --dry-run --json",
    "smoke:package": "node scripts/smoke-package.mjs",
    "release:preflight": "npm run typecheck && npm test && npm run visual:audit && npm run pack:dry && npm run smoke:package",
    "prepublishOnly": "npm run release:preflight"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "map",
    "pictogram",
    "wayfinding",
    "business-card",
    "yakdo",
    "약도",
    "openstreetmap",
    "svg",
    "claude",
    "anthropic"
  ],
  "author": "heznpc",
  "license": "MIT",
  "homepage": "https://github.com/heznpc/cairn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heznpc/cairn.git"
  },
  "bugs": {
    "url": "https://github.com/heznpc/cairn/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "ajv": "^8.17.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22"
  }
}
